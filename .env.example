# GitHub data for the "Where I build" section.
# Copy this file to .env.local and fill in your own values.

# Public GitHub username used for the profile card and contribution graph.
GITHUB_USERNAME=your-github-username

# Classic personal access token with the read:user scope.
# Server-only secret: never prefix it with NEXT_PUBLIC_.
GITHUB_TOKEN=ghp_replace_me

# Address that receives contact form messages.
CONTACT_EMAIL=your-email@example.com

# Resend configuration. The sender must be verified in Resend.
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=onboarding@resend.dev

# Public site URL for canonical URLs, Open Graph, sitemap, and robots.txt.
# Example: https://ariffarhan.dev or https://portfolio-arif.vercel.app
SITE_URL=https://ariffarhan.dev

# Google Search Console HTML tag verification code (optional)
# Found in Search Console: Search Console > Ownership verification > HTML tag
GOOGLE_SITE_VERIFICATION=
